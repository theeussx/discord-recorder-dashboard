# Example environment variables for local deployment
# Change the values before deploying.

ADMIN_USER=admin
ADMIN_PASS=changeme
JWT_SECRET=replace_with_a_strong_secret
NODE_ENV=development
PORT=3000

# Optional: connect to your bot for real data
# If your bot uses HTTPS, prefer the hostname that matches its cert.
# Example: BOT_API_BASE=https://cn-01.hostzera.com.br:8080/api
BOT_HOST=
BOT_PORT=
BOT_PROTOCOL=http
BOT_AUTH_TOKEN=
# or set BOT_API_BASE to a full base URL like https://cn-01.hostzera.com.br:8080/api
BOT_API_BASE=

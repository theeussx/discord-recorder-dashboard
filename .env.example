# ── Auth local ─────────────────────────────────────────────────────────────────
# Hash bcrypt da senha do admin.
# Para gerar: node -e "require('bcryptjs').hash('SUA_SENHA',12).then(console.log)"
# Exemplo abaixo = senha "admin123" (TROQUE ANTES DE USAR)
ADMIN_PASS_HASH=$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TiGnvRm9GJuHUoZoXvV3jJlJHKpK

# JWT — string longa e aleatória (mínimo 32 chars)
JWT_SECRET=troque_por_uma_string_muito_longa_e_aleatoria

# Servidor
NODE_ENV=production

# Bot API — URL da API do seu bot Discord
# Exemplo: https://seu-bot-api.com/api
BOT_API_BASE=https://seu-bot-api.com/api

# Frontend — URL pública da API do bot (para players de áudio)
VITE_BOT_API_BASE=https://seu-bot-api.com/api
